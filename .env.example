# ===========================================================================
# Echo — frontend environment
# ===========================================================================
# Only values prefixed with VITE_ reach the browser bundle. Everything with a
# secret key (SocialFetch, OpenAI, Stripe) belongs in Edge Function secrets,
# NOT here.
#
#   supabase secrets set SOCIALFETCH_API_KEY=sfk_...
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
#   supabase secrets set APP_ORIGIN=https://your-app.example
#   supabase secrets set SWEEP_CRON_SECRET=<long random string>
# ===========================================================================

# Supabase project — the anon key is public by design (Row Level Security is
# what protects your data).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here