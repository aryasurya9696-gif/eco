# ===========================================================================
# Echo — frontend environment
# ===========================================================================
# Only values prefixed with VITE_ reach the browser bundle. Everything with a
# secret key belongs in Edge Function secrets, NOT here.
#
# Search providers, in the order the sweep tries them:
#   supabase secrets set TREG_TOKEN=treg_...
#       treg.to — primary. One token, many providers, ~$0.0004-0.0019 a call.
#       Sign up at https://treg.to (free, $1.00 of starting credit).
#   supabase secrets set SOCIALFETCH_API_KEY=sfk_...
#       Fallback, used only when treg's providers cannot answer. 1 credit a
#       call. Also the only source for LinkedIn, which treg cannot search.
#
# Other secrets:
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
#   supabase secrets set APP_ORIGIN=https://your-app.example
#   supabase secrets set SWEEP_CRON_SECRET=<long random string>
#
# Each of the two search keys also falls back to public.service_secrets, a
# table with RLS on and no policies, so only the service role can read it.
# ===========================================================================

# Supabase project — the anon key is public by design (Row Level Security is
# what protects your data).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here