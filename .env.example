# ===========================================================================
# Echo — frontend environment
# ===========================================================================
# Only values prefixed with VITE_ reach the browser bundle. Everything with a
# secret key belongs in Edge Function secrets, NOT here.
#
# Search provider:
#   supabase secrets set TREG_TOKEN=treg_...
#       treg.to — one token for 3,900+ endpoints across many providers, billed
#       per call at the provider's own rate with no markup. Sign up at
#       https://treg.to (free, $1.00 of starting credit).
#
# It also falls back to public.service_secrets, a table with RLS on and no
# policies, so only the service role can read it.
#
# Other secrets:
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set DODO_PAYMENTS_API_KEY=...
#   supabase secrets set DODO_PAYMENTS_WEBHOOK_KEY=whsec_...
#   supabase secrets set DODO_ENVIRONMENT=live_mode      # anything else = test mode
#   supabase secrets set APP_ORIGIN=https://your-app.example
#   supabase secrets set ALLOWED_ORIGIN=https://your-app.example
#   supabase secrets set SWEEP_CRON_SECRET=<at least 32 random characters>
#   supabase secrets set RESEND_API_KEY=re_...           # Mail: hosted-domain sending + DNS verification
#
# Dodo product ids live in the database, not here:
#   update public.topup_packages set provider_ref = 'pdt_...' where code = 'starter_200';
# ===========================================================================

# Supabase project — the anon key is public by design (Row Level Security is
# what protects your data).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here