# ===========================================================================
# Echo — frontend environment
# ===========================================================================
# Copy to `.env` and fill in the two values below. That is all the frontend
# needs. The same two variables go into your static host's environment
# settings (Vercel, Netlify, …) for production builds.
#
# Only VITE_ variables reach the browser, and they end up in the public
# JavaScript bundle. Never put a secret here: no service role key, no treg
# token, no OpenAI / Dodo / Resend / X / Reddit key.
#
# Server-side secrets go to the edge functions instead:
#   cp supabase/secrets.example.env supabase/.secrets.env   # fill it in
#   npx supabase secrets set --project-ref <ref> --env-file supabase/.secrets.env
#
# Full walkthrough for a new project: SETUP.md
# ===========================================================================

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → anon / public key. Public by design:
# Row Level Security is what protects the data.
VITE_SUPABASE_ANON_KEY=your-anon-key-here
