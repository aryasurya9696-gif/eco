# ===========================================================================
# Echo — edge function secrets (template)
# ===========================================================================
# 1. Copy this file:   cp supabase/secrets.example.env supabase/.secrets.env
#    (`*.secrets.env` is git-ignored; never commit the filled-in copy)
# 2. Fill in every uncommented value. Optional features are commented out:
#    uncomment and fill a line to turn that feature on.
# 3. Push them:        npx supabase secrets set --project-ref <ref> --env-file supabase/.secrets.env
# 4. Redeploy so running functions pick them up:
#                      SUPABASE_PROJECT_REF=<ref> node scripts/deploy-functions.cjs
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# by Supabase automatically. Do not set them here.
# See SETUP.md step 4 for what each one does and what breaks without it.
# ===========================================================================

# --- Required ---------------------------------------------------------------

# treg.to org token (trg_live_...). Sweeps, leads, enrichment.
TREG_TOKEN=

# OpenAI key (sk-...). AI reply drafts and keyword suggestions.
OPENAI_API_KEY=

# Where the frontend is served, exactly: scheme + host, no trailing slash.
APP_ORIGIN=https://app.example.com

# Origins allowed to call the API (comma-separated). Usually the same as APP_ORIGIN.
ALLOWED_ORIGIN=https://app.example.com

# Same value as public.service_secrets.sweep_cron_secret (SETUP.md step 3).
# At least 32 characters.
SWEEP_CRON_SECRET=

# --- Payments: Dodo ---------------------------------------------------------

DODO_PAYMENTS_API_KEY=
# Signing secret of the webhook pointing at /functions/v1/billing-webhook (whsec_...)
DODO_PAYMENTS_WEBHOOK_KEY=
# live_mode for real money; anything else is Dodo's test mode.
DODO_ENVIRONMENT=test_mode

# --- Echo Mail: Resend (optional) ---------------------------------------------

# RESEND_API_KEY=
# Signing secret of the Resend webhook pointing at /functions/v1/mail-inbound
# RESEND_WEBHOOK_SECRET=
# Shared domain Echo mailboxes live on, e.g. mail.example.com. Unset = off.
# MAIL_SHARED_DOMAIN=
# Sends per day on the shared domain (default 2000).
# MAIL_PLATFORM_DAILY_CAP=

# One-click DNS setup (optional; see the header of supabase/functions/mail/index.ts)
# DOMAIN_CONNECT_PROVIDER_ID=
# DOMAIN_CONNECT_SERVICE_ID=
# DOMAIN_CONNECT_PRIVATE_KEY=
# DOMAIN_CONNECT_KEY_HOST=
# DOMAIN_CONNECT_REDIRECT_URI=

# --- Social replies (optional) --------------------------------------------------
# Redirect URI for both apps: https://<project-ref>.supabase.co/functions/v1/social

# X_CLIENT_ID=
# X_CLIENT_SECRET=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=web:echo:1.0 (by /u/yourname)

# --- Optional tuning ---------------------------------------------------------------

# Default gpt-4o-mini.
# OPENAI_MODEL=
# USD per 1M tokens, for cost tracking only.
# OPENAI_PRICE_INPUT=
# OPENAI_PRICE_OUTPUT=
